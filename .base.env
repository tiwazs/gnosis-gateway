LISTEN=:8080
PORT=8080
MAIN_SERVICE=<main-service-url>
WORKSPACE_SERVICE=<workspace-service-url>
IOT_SERVICE=<iot-service-url>
TOKEN_KEY=<same-as-gnosis-main-service>
GATEWAY_INTERNAL_SECRET=<shared-secret-with-main-service>

# K8S env vars
# $ set -o allexport
# $ source .env
# $ set +o allexport
# $ envsubst < deployment/k8s.yaml > deployment/k8s_patched.yaml

IMAGE_NAME=<image-name>
IMAGE_TAG=<image-tag>
DOMAIN=<gateway-public-host>
CORS_ALLOW_ORIGIN=<cors-origins>
CLUSTER_ISSUER=<cert-manager-cluster-issuer>

K8S_MIN_REPLICAS=1
K8S_NAMESPACE=<deployment-namespace>
K8S_RESOURCES_LIMITS_CPU=500m
K8S_RESOURCES_LIMITS_MEMORY=256Mi
K8S_RESOURCES_REQUESTS_CPU=20m
K8S_RESOURCES_REQUESTS_MEMORY=30Mi
K8S_SERVICE_NAME=gnosis-gateway
